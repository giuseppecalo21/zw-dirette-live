						<div class="cs-overlay-background cs-overlay-transparent">
							<img width="80" height="80" src="https://www.wrestleview.com/wp-content/uploads/2026/11/purrazzo-80x80.jpg" class="attachment-csco-smaller size-csco-smaller wp-post-image" alt="" decoding="async" loading="lazy" srcset="https://www.wrestleview.com/wp-content/uploads/2026/11/purrazzo-80x80.jpg 80w, https://www.wrestleview.com/wp-content/uploads/2026/11/purrazzo-110x110.jpg 110w" sizes="auto, (max-width: 80px) 100vw, 80px" />						</div>

						<a class="cs-overlay-link" href="https://www.wrestleview.com/aew-news/397205-roh-aew-talent-holding-wrestling-fundraiser-show-for-alma-mater/"></a>
					</div>
				
				<div class="cs-entry__inner cs-entry__content">
					
					<h3 class="cs-entry__title">
						<a href="https://www.wrestleview.com/aew-news/397205-roh-aew-talent-holding-wrestling-fundraiser-show-for-alma-mater/">ROH-AEW talent holding wrestling fundraiser show for alma mater</a>
					</h3>

									</div>
			</div>
		</article>
								</li>
											<li class="pk-post-item">
									<article class="post-397168 post type-post status-publish format-standard has-post-thumbnail category-aew-collision-results category-aew-dynamite-results category-top-story tag-11-11-26-aew-collision-results tag-11-11-26-aew-dynamite-results tag-aew tag-collision tag-dynamite tag-hbo-max tag-salt-lake-city tag-tbs tag-utah tag-west-valley-city cs-entry cs-video-wrap" style="">
			<div class="cs-entry__outer">
