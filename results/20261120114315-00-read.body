<style id="fightful-patreon-tier-inline-css">

    .main-menu .menu li.nav-select > a.ptrn-login,
    .main-menu .menu li.nav-select > a.ptrn-select-access {
      display: inline-block;
      margin: 0 10px;
      padding: 7px 16px;
      border: 1px solid #d4a017;
      border-radius: 4px;
      color: #d4a017;
      font-weight: 700;
      line-height: 1.4;
      text-transform: uppercase;
      transition: background .2s, color .2s;
    }
    .main-menu .menu li.nav-select > a.ptrn-login:hover,
    .main-menu .menu li.nav-select > a.ptrn-select-access:hover {
      background: #d4a017;
      color: #000;
    }
  
/*# sourceURL=fightful-patreon-tier-inline-css */
</style>
