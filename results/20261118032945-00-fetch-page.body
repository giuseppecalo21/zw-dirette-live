        <div id="content" class="article">
            

            <article class="news-post">
    
    
    
                <div class="news-article">
                <h1 class="title-gallery" data-post-id="2318773" id="title-gallery" data-author="Olivia Quinlan" data-category="wwe-news" data-content_type="Liveblog" data-mod_date="2026-11-17" data-layout="Infinite" data-post_id="2318773" data-pub_date="2026-11-17" data-day="Tuesday" data-dayhour="Tuesday-5PM" data-pubhour="5PM" data-num_slides="2" data-num_words="200" data-pitcher="Olivia Quinlan" data-trello_board="News" data-intent="liveblog" data-ideation="liveblog">WWE NXT Results 11/17/26 W/ Live Updates: Izzi Dame Challenges Zaria, Women's Title Match, More</h1>
					
            </div>

    
                <div class="news-article">
                                <div class="byline-container">
                    <div class="byline-text-wrap">
                        <span class="byline-by">By</span> <a href="/author/oliviaquinlan/" class="byline-author">Olivia Quinlan</a>
                         <span>and</span> <a href="/author/rossberman/" class="byline-author">Ross W Berman IV</a>
                        <span class="byline-timestamp">
                            <time datetime="2026-11-18T03:18:19+00:00">Updated: Nov. 17, 2026 10:18 pm EST</time>
                        </span>
                    </div>
                    
                </div>
                                <div class="slide-key image-holder gallery-image-holder credit-image-wrap  lead-image-holder" data-post-url="https://www.wrestlinginc.com/2318773/wwe-nxt-november-17-2026-results/" data-post-title="WWE NXT Results 11/17/26 W/ Live Updates: Izzi Dame Challenges Zaria, Women's Title Match, More" data-slide-num="0" data-post-id="2318773">
                         
                                             <picture id="p309d00b3910d07c29b032c2552ab635b">
                                                    <source media="(min-width: 429px)" srcset="https://www.wrestlinginc.com/img/gallery/wwe-nxt-results-111026-w-live-updates/intro-1794891345.webp" type="image/webp">
                            <source media="(max-width: 428px)" srcset="https://www.wrestlinginc.com/img/gallery/wwe-nxt-results-111026-w-live-updates/intro-1794891345.sm.webp" type="image/webp">
                        <img class="gallery-image " src="https://www.wrestlinginc.com/img/gallery/wwe-nxt-results-111026-w-live-updates/intro-1794891345.jpg" data-slide-url="https://www.wrestlinginc.com/2318773/wwe-nxt-november-17-2026-results/" data-post-id="2318773" data-slide-num="0" data-slide-title="WWE NXT Results 11/17/26 W/ Live Updates: Izzi Dame Challenges Zaria, Women's Title Match, More: " width="780" height="438" alt="Grey and Jordan in the ring during a verbal confrontation">
                    </source></source></picture>
                    <a class="gallery-image-credit" href="https://www.wwe.com/videos/kendal-grey-sets-her-sights-on-kelani-jordan-nxt-highlights-nov-10-2026" target="_blank">WWE</a>
                    </div>
                        <div class="columns-holder">
            <div class="add-on-google-widget">
                <div class="add-on-google-heading">Add Wrestling Inc. on Google:</div>
                <div class="add-on-google-buttons-row">
                    <button type="button" class="add-on-google-btn" id="preferred-source">Preferred Source</button>
