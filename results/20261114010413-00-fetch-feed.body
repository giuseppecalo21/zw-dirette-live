			</item>
		<item>
		<title>WWF Raw Results &#8211; 11/11/96 (Final build to Survivor Series, Shawn Michaels and Sycho Sid go for the Tag Team Titles)</title>
		<link>https://www.wrestleview.com/retro/397331-wwf-raw-results-november-11-1996-fort-wayne/</link>
					<comments>https://www.wrestleview.com/retro/397331-wwf-raw-results-november-11-1996-fort-wayne/#respond</comments>
		
		<dc:creator><![CDATA[Mike Tedesco]]></dc:creator>
		<pubDate>Fri, 13 Nov 2026 04:45:00 +0000</pubDate>
				<category><![CDATA[Featured Top Story]]></category>
		<category><![CDATA[Retro]]></category>
