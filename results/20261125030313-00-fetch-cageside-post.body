eturns to her Hooters roots for new gig","description":{"html":"The WWE Women’s World Champion landed a new acting role she’s got some familiarity with."},"image":{"thumbnails":{"horizontal":{"url":"https://platform.cagesideseats.com/wp-content/uploads/sites/54/2026/01/gettyimages-2254252245.jpg?quality=90\u0026strip=all\u0026crop=0,0,100,100"},"square":{"url":"https://platform.cagesideseats.com/wp-content/uploads/sites/54/2026/01/gettyimages-2254252245.jpg?quality=90\u0026strip=all\u0026crop=16.666666666667,0,66.666666666667,100"}},"id":"c2I1NDppbWFnZTo0MTIyNDc="}},"primaryCampaign":null,"ledeMedia":{"__typename":"LedeMediaImageType","image":{"thumbnails":{"horizontal":{"url":"https://platform.cagesideseats.com/wp-content/uploads/sites/54/2026/01/gettyimages-2254252245.jpg?quality=90\u0026strip=all\u0026crop=0,0,100,100"},"square":{"url":"https://platform.cagesideseats.com/wp-content/uploads/sites/54/2026/01/gettyimages-2254252245.jpg?quality=90\u0026strip=all\u0026crop=16.666666666667,0,66.666666666667,100"}},"id":"c2I1NDppbWFnZTo0MTIyNDc="}},"comments":{"enabled":true,"mode":"standard"},"streams":{"nodes":[]},"blocks":[{"__typename":"CoreParagraphBlockType"},{"__typename":"CoreParagraphBlockType"},{"__typename":"CoreParagraphBlockType"},{"__typename":"CoreParagraphBlockType"},{"__typename":"CoreParagraphBlockType"},{"__typename":"CoreParagraphBlockType"},{"__typename":"CoreParagraphBlockType"},{"__typename":"CoreParagraphBlockType"},{"__typename":"CoreParagraphBlockType"},{"__typename":"CoreEmbedBlockType"},{"__typename":"CoreParagraphBlockType"},{"__typename":"CoreParagraphBlockType"},{"__typename":"CoreParagraphBlockType"}],"customBadgeEnabled":false,"customBadgeName":"","template":null},{"__typename":"PostResourceType","__isFeedContentResourceInterface":"PostResourceType","id":"c2I1NDpwb3N0OjQ4ODMxMQ==","wpId":488311,"globalId":"c2I1NDpwb3N0OjQ4ODMxMQ","chorusId":null,"chorusUuid":null,"resourceType":"post","site":{"isCrossCommunity":false,"wpId":54},"dek":{"h