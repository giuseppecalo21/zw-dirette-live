rsity"},"sameAs":["https:\/\/x.com\/samantha_1713","https:\/\/www.linkedin.com\/in\/samanthaschipman"]}],"publisher":{"@type":"Organization","address":{"@type":"PostalAddress","streetAddress":"11787 Lantern Road #201","addressLocality":"Fishers","addressRegion":"IN","postalCode":"46038","addressCountry":"US"},"contactPoint":{"@type":"ContactPoint","telephone":"(908) 514-8038","contactType":"customer support","email":"staff@wrestlinginc.com"},"publishingPrinciples":"https:\/\/www.wrestlinginc.com\/policies\/","@id":"https:\/\/www.wrestlinginc.com\/","name":"Wrestling Inc.","url":"https:\/\/www.wrestlinginc.com\/","logo":{"@type":"ImageObject","url":"https:\/\/www.wrestlinginc.com\/img\/winc-share-image-1280x720.png","caption":"Wrestling Inc. Logo"},"description":"The latest WWE, AEW, NJPW real-time results, news, exclusive interviews, live coverage, and more - since 1997.","sameAs":["https:\/\/www.facebook.com\/WrestlingINC","https:\/\/x.com\/wrestlinginc","https:\/\/subscribe.wrestlinginc.com\/newsletter","https:\/\/www.youtube.com\/@WrestlingINC","https:\/\/flipboard.com\/@wrestleinc","https:\/\/profile.google.com\/@wrestlinginc"]},"description":"This is Wrestling Inc.'s live coverage of the &quot;AEW Dynamite\/Collision&quot; double-bill emanating from West Valley City in Utah."}</script>
<script type="application/ld+json">{"@context":"http:\/\/schema.org","@type":"LiveBlogPosting","mainEntityOfPage":{"@type":"WebPage","@id":"https:\/\/www.wrestlinginc.com\/2314240\/aew-dynamite-november-11-2026-results\/","url":"https:\/\/www.wrestlinginc.com\/2314240\/aew-dynamite-november-11-2026-results\/","breadcrumb":{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"item":{"@id":"https:\/\/www.wrestlinginc.com\/category\/aew-news\/","name":"AEW News"}}]}},"isAccessibleForFree":true,"headline":"AEW Dynamite\/Collision Results: Ilja Dragunov Challenges National Champion W\/ Live Updates","image":{"@type":"ImageObject","url":"https:\/\/www.wrestlinginc.com\/img\/gallery\/aew-dynamite-collision-results-111126-w-live-updates\/l-intro-1794452760.jpg","height":898,"width":1600},"datePublished":"2026-11-11T22:00:00+00:00","dateModified":"2026-11-12T04:01:39+00:00","author":[{"@type":"Person","name":"Max Everett","description":"Max started out as a professional writer in the summer of 2020. He first covered gaming, writing news, reviews, and features for sites like Generation Xbox and Pure PlayStation.","url":"https:\/\/www.wrestlinginc.com\/author\/maxeverett\/","knowsAbout":["WWE","AEW","MMA and Boxing"],"alumniOf":[{"@type":"Organization","name":"Birchwood High School"},{"@type":"Organization","name":"Harlow College"}],"sameAs":["https:\/\/x.com\/max_everett10","https:\/\/www.linkedin.com\/in\/max-everett-b46619219"]},{"@type":"Person","name":"Samantha Schipman","description":"Sam has been writing about wrestling since 2019 and got her start writing for FanSided after attending All In in Chicago. She covered the Wednesday Night Wars and \"WWE 205 Live.\" She also writes for Daily DDT and Let Them Wrestle, where she covers AEW, ROH, news stories, women's wrestling, and opinion pieces.","url":"https:\/\/www.wrestlinginc.com\/author\/samanthaschipman\/","knowsAbout":["AEW","WWE","ROH"],"alumniOf":{"@type":"Organization","name":"Wingate University"},"sameAs":["https:\/\/x.com\/samantha_1713","https:\/\/www.linkedin.com\/in\/samanthaschipman"]}],"publisher":{"@type":"Organization","address":{"@type":"PostalAddress","streetAddress":"11787 Lantern Road #201","addressLocality":"Fishers","addressRegion":"IN","postalCode":"46038","addressCountry":"US"},"contactPoint":{"@type":"ContactPoint","telephone":"(908) 514-8038","contactType":"customer support","email":"staff@wrestlinginc.com"},"publishingPrinciples":"https:\/\/www.wrestlinginc.com\/policies\/","@id":"https:\/\/www.wrestlinginc.com\/","name":"Wrestling Inc.","url":"https:\/\/www.wrestlinginc.com\/","logo":{"@type":"ImageObject","url":"https:\/\/www.wrestlinginc.com\/img\/winc-share-image-1280x720.png","caption":"Wrestling Inc. Logo"},"description":"The latest WWE, AEW, NJPW real-time results, news, exclusive interviews, live coverage, and more - since 1997.","sameAs":["https:\/\/www.facebook.com\/WrestlingINC","https:\/\/x.com\/wrestlinginc","https:\/\/subscribe.wrestlinginc.com\/newsletter","https:\/\/www.youtube.com\/@WrestlingINC","https:\/\/flipboard.com\/@wrestleinc","https:\/\/profile.google.com\/@wrestlinginc"]},"description":"This is Wrestling Inc.'s live coverage of the &quot;AEW Dynamite\/Collision&quot; double-bill emanating from West Valley City in Utah.","coverageStartTime":"2026-11-12T00:30:00+00:00","articleBody":"Welcome to Wrestling Inc.'s coverage of &quot;AEW Dynamite\/Collision&quot; on November 11, 2026, coming to you from the Maverik Center in West Valley City, Utah! The action kicks off at 8 PM ET and you can watch along with us on TBS and HBO Max in the United States and MyAEW internationally.\nTonight's three-hour double bill will serve as the go-home show for Full Gear on Saturday, with Will Ospreay and Kyle Fletcher due to come face-to-face ahead of their World Championship clash this weekend. Fletcher stood over a bloodied Ospreay in the main event of last week's show, forcing Adam Copeland to surrender in the Men's Blood &amp; Guts match.&nbsp;\nMercedes Mone and Marina Shafir are set to prelude their Women's World Championship match in mixed tag team action, Mone joining The Cut's Jay White in his faction war with the Death Riders through Shafir and Jon Moxley.&nbsp; &nbsp;\nFormer AEW Tag Team Champions Brodido will be fielding multi-time WWE Tag Team Champions the New Level in a first-time clash, itself a preview to the Trios Texas Deathmatch this weekend for the World Trios Championship held by Brodido and &quot;Hangman&quot; Adam Page against Swerve Strickland and the New Level.&nbsp;\nThe AEW National title will be on the line as Tommaso Ciampa makes his first defense against Mike Bailey, representing United Empire. Ciampa dethroned Bailey's stablemate, Andrade El Idolo, for the title on Saturday's &quot;AEW Collision.&quot; And, with the Best of Five Series tied at 2-2, FTR and Motor City Machine Guns will battle one last time in the tie-breaker tag team bout.\n","liveBlogUpdate":[{"@type":"BlogPosting","url":"https:\/\/www.wrestlinginc.com\/2314240\/aew-dynamite-november-11-2026-results\/#update-4624","articleBody":"\"AEW Dynamite\/Collision\" is just fifteen minutes away!\r\nWhat matches can you see being announced for Full Gear? Who wins between Brodido and New Level? Will Page or Strickland cost either of their teammates?&nbsp;\r\nLet us know your answers and any other predictions in the comments below. ","datePublished":"2026-11-12T00:47:50+00:00","author":{"@type":"Person","name":"Max Everett"}},{"@type":"BlogPosting","url":"https:\/\/www.wrestlinginc.com\/2314240\/aew-dynamite-november-11-2026-results\/#update-4625","articleBody":"We are live!&nbsp;\r\nExcalibur runs down the card for the night, with Orange Cassidy versus David Finlay in singles action added.&nbsp;\r\nQueen Aminata will be defending her TBS Championship against Skye Blue and Hyan in a three-way. The Young Bucks are teaming with Jack Perry against Kevin Knight, El Clon, and Brian Cage of the Don Callis Family, a preview to Jake Doyle and Mark Davis' challenge for the Tag titles this weekend.&nbsp;\r\nA recap package plays for \"Blood & Guts.\"","datePublished":"2026-11-12T01:03:23+00:00","author":{"@type":"Person","name":"Max Everett"}},{"@type":"BlogPosting","url":"https:\/\/www.wrestlinginc.com\/2314240\/aew-dynamite-november-11-2026-results\/#update-4626","articleBody":"A backstage segment is shown of Will Ospreay, the Young Bucks, Steven Borden, and Adam Copeland after their Blood & Guts loss.&nbsp;\r\nOspreay takes umbrage with Copeland surrendering, despite having all agreed they wouldn't. Copeland tells Ospreay to shut up, reminding him he had to retire for nine years because of the decisions he made in his career. He asks Ospreay if he wants to have another neck fusion. He says he doesn't want to see anyone else go through what he went through, and if they cannot get that, then maybe it isn't the place to be. He walks off to close the segment. \r\n[embed=https:\/\/x.com\/AEW\/status\/2120685170327978016]","datePublished":"2026-11-12T01:07:24+00:00","author":{"@type":"Person","name":"Max Everett"}},{"@type":"BlogPosting","url":"https:\/\/www.wrestlinginc.com\/2314240\/aew-dynamite-november-11-2026-results\/#update-4627","articleBody":"Kyle Fletcher is out first for his face-to-face with Ospreay. He takes a microphone before Ospreay's music hits to precede his own entrance.&nbsp;\r\nFletcher calls for Ospreay's music to be cut short before the crowd breaks into an \"Ospreay! Ospreay!\" chant. He says he will not stand here listening to that.&nbsp;\r\nHe has to listen instead to a \"F*** Don Callis\" chant, asks the crowd if they're done. They boo in response, and he says he tells them when they're done and they are.\r\nFletcher turns his attention to Ospreay. He says that so much has happened since the last time they talked it out in the ring. He notes that Ospreay has gotten married, he's had neck surgery, and he's won the World title.\r\nMeanwhile, Fletcher has been a two-time TNT Champion, World Trios Champion, and International Champion. But he is aware that none of that would have come without Ospreay, and for that, he thanks him.&nbsp;\r\nOspreay says this wasn't what he expected, but he is proud of Fletcher, and hopes one day he can be proud of him. Fletcher cuts him off and says not to twist what he was saying. He would still do all of the heinous things he's done to Ospreay all over again.&nbsp;\r\nFletcher takes issue with the fact that Ospreay blamed his neck injury on the Death Riders. He says he was the one that did that, with the Tiger Driver and the Buckle Brainbuster, and he demands credit for that.&nbsp;\r\nOspreay admits he did do that to him. He wrestled with effectively one arm because of Fletcher, because of an injury he sustained seven months into his AEW career. Ospreay says that he was inspired to return for the crowd, calling their reaction morphine and hearkening back to when Australia cheered him over their home country boy.&nbsp;\r\nHe says Fletcher can have all the credit in the world, but he might not want to brag about it, because even with a broken neck, \"I smoked you twice, bruv.\"\r\nOspreay asks Fletcher if he really believes he stands a chance. Fletcher nods. Ospreay says he beat seven others in Clockwork Carnage, he shot the Black Arrow when the world needed it most, and he beat Kenny Omega for the World title at Wembley.&nbsp;\r\nOspreay calls for a video to play on the Titantron. It's the moment Fletcher and Ospreay come face-to-face in Ospreay's All In entrance. He says, \"Tell me what you were feeling in that moment.\"The crowd chants \"Jealous.\"\r\nFletcher says he felt absolutely nothing. Ospreay calls bulls*** and asks again. He says if he really hated him that much, he wouldn't have stood aside. He reckons that deep down, Fletcher and Davis wanted to be ringside in that moment.&nbsp;\r\nFletcher relents and screams that he felt jealous. \"I had to watch the man I hate most in the world walk out there and achieve my dream!\"\r\nBut, he says, that feeling did not last long. Because he knew that he was going to be the one to take it from him.&nbsp;\r\nOspreay says he still doesn't believe him. He thinks this could have been two brothers putting it all to the side for the World Championship, and this still can be. He says that deep down, he knows Fletcher still loves him, and he still loves him.&nbsp;\r\nFletcher loses his cool completely, telling Ospreay to stop playing with his head. He says one day, everyone is going to realize Ospreay is all about himself. One day, Alex Windsor will realize it, and she will leave him. One day, his son will be a grown man, and he will either realize it or Fletcher will be there to help him.&nbsp;\r\nAt Full Gear, he says, he will take everything from Ospreay.&nbsp;\r\nOspreay says that he will say one last thing; Fletcher has improved immeasurably, but they are not equals. He has fives wins over him out of six. And he will be bringing the same intensity he used to put down someone like Jon Moxley.&nbsp;\r\nFletcher slaps Ospreay in the face before he can conclude. He goads him into doing something. But Ospreay doesn't give him the satisfaction. ","datePublished":"2026-11-12T01:28:06+00:00","author":{"@type":"Person","name":"Max Everett"}},{"@type":"BlogPosting","url":"https:\/\/www.wrestlinginc.com\/2314240\/aew-dynamite-november-11-2026-results\/#update-4628","articleBody":"Brodido can't even finish their entrance as Austin Creed and Kofi take them out with suicide dives. Kofi and Creed work together to take down Brody King before Bandido comes back to remove Kofi from the situation.&nbsp;\r\nKing takes control over Creed on the other side, setting him atop a steel chair and squishing him with a crossbody onto it against the barricade. King dispenses Creed into the ring and the bell rings.&nbsp;\r\nCreed sends King to the outside and takes him out with another dive. Bandido follows up with a leap over the ropes, and Kofi flies from the top rope to take him out.&nbsp;\r\nKofi grabs a chair and throws it into the ring. Creed throws another into the ring. Commentary points out they can be disqualified if they take this too far.&nbsp;","datePublished":"2026-11-12T01:34:35+00:00","headline":"The New Level vs. Brodido ","author":{"@type":"Person","name":"Max Everett"}},{"@type":"BlogPosting","url":"https:\/\/www.wrestlinginc.com\/2314240\/aew-dynamite-november-11-2026-results\/#update-4629","articleBody":"King throws Kofi into the crowd and looks to suplex him back in with Bandido. Creed looks to come to the rescue, gets beaten back, and they complete the suplex.&nbsp;\r\nCommentary points out the referee is being very lenient with the count-out (it's certainly been more than 10 seconds by now).&nbsp;\r\nAll four men get back in the ring and now it's Creed and Kofi rallying with strikes. Bandido gets the better of Creed while Kofi still has the advantage on King. King rectifies that with a comedically hard chop to deck Kofi.&nbsp;\r\nCreed starts punching out at King but, aptly, punches himself out before getting dropped. King takes Kofi outside of the ring while Bandido continues to work Creed.&nbsp;\r\nCreed comes back with a pop-up knee strike, King comes in and drops him. Kofi comes back to take out King, and Bandido takes him out before getting a Fisherman's Buster from Creed.&nbsp;\r\nKing decks Creed and Kofi with a double lariat. He follows that up with a suicide dive to the barks of the crowd.&nbsp;\r\nCreed and Kofi work together to whip King into the steel steps. Bandido leaps over said steps to take them both out. He begins to drag Creed up the ramp.&nbsp;\r\nBandido begins calling for a table. Kofi comes after him with a steel chair, misses, but the referee has called a no-contest.&nbsp;\r\nBrodido vs. New Level ends in No-Contest via Double Count-Out\r\nBandido and King continue as planned, the former looking to press Kofi through a table set up next to the ramp. Kofi slips it and security comes out. But Kofi takes flight to send King through the table with a crossbody. Bandido presses a security guard into those between him and Creed, and they brawl out of shot to close the segment. ","datePublished":"2026-11-12T01:42:16+00:00","author":{"@type":"Person","name":"Max Everett"}},{"@type":"BlogPosting","url":"https:\/\/www.wrestlinginc.com\/2314240\/aew-dynamite-november-11-2026-results\/#update-4630","articleBody":"AEW ran a video honoring the various roster members who have served in the armed forces, including Bobby Lashley, Trish Adora, and more.\r\n[embed=https:\/\/x.com\/AEW\/status\/2120694244922826925]","datePublished":"2026-11-12T01:46:02+00:00","headline":"AEW Honors Its Elite Veterans","author":{"@type":"Person","name":"Ross W Berman IV"}},{"@type":"BlogPosting","url":"https:\/\/www.wrestlinginc.com\/2314240\/aew-dynamite-november-11-2026-results\/#update-4631","articleBody":"Renee Paquette notes as Finlay makes the second entrance that everyone else has been banned from ringside for this. No Cut, no Death Riders, no Conglomeration.&nbsp;\r\nCassidy pushes the shillelagh beneath the ring before the match gets started. He gets in the ring to get things started, slipping and sliding around Finlay for a roll-up and a back-slide for two-counts. He gets another roll-up for two but Finlay comes back at him. Cassidy rolls out of the ring for a breather.&nbsp;\r\nFinlay gives chase after some time and Cassidy runs back in the ring. Finlay gets back in the ring and Cassidy gets out on the other side. Cassidy returns to the ring as Finlay feigns chasing him again, coming back at him with a lariat. Cassidy ducks it and gets out of the ring again.&nbsp;\r\nFinlay gets out on the other side for a stand-off until the count of nine. They both return to the ring at the same time, but Cassidy gets the better of Finlay again, sending him out of the ring and hitting a tope. He smashes him into the apron and throws him back into the ring, going to the top rope\r\nCassidy takes flight but Finlay catches him and drops him with a backbreaker. He goes to the outside and continues to target the back with a belly-to-back suplex onto the apron. ","datePublished":"2026-11-12T01:53:28+00:00","headline":"Orange Cassidy vs. David Finlay ","author":{"@type":"Person","name":"Max Everett"}},{"@type":"BlogPosting","url":"https:\/\/www.wrestlinginc.com\/2314240\/aew-dynamite-november-11-2026-results\/#update-4632","articleBody":"Finlay brings Cassidy back into the ring and continues to stomp down at him in the corner. He grabs him by the ears into a suplex, releasing to send Cassidy flying to the other side of the ring.&nbsp;\r\nFinlay goes for a lateral press but Cassidy puts his foot on the bottom rope. Finlay digs his elbow into Cassidy's face before getting back up.&nbsp;\r\nFinlay hammer throws Cassidy into the opposing corner, leaving him to snap back down to the mat. Cassidy tries to fight up from his feet but keeps getting put back down. All the same, he keeps getting up, finally putting his hands in his pockets.&nbsp;\r\nFinlay teases doing the same but knocks Cassidy to the mat with a rolling elbow. He looks to follow up with a suplex, Cassidy makes use of his legs to stall twice over. Finlay powers him up for a third attempt, but Cassidy reverses it for his own suplex.&nbsp;\r\nCassidy leaps onto the apron and takes Finlay's face for an immersive tour of the turnbuckle pads. He comes back in the ring for a Stundog Millionaire and a Tornado DDT.&nbsp;\r\nFinlay runs at Cassidy in the corner, tripping him into the bottom buckle pad. Cassidy goes to the top rope, Finlay joins him and bits into his head. Finlay now looks for a superplex but Cassidy fights back, biting at Finlay's head and raking his back before discarding him back down to the ring.&nbsp;\r\nCassidy takes flight and connects with a diving DDT, but Finlay rolls out of the ring before he can make the cover. Finlay crawls to the ring skirt, grabbing out the shillelagh and a steel chair.&nbsp;\r\nHe throws the chair in the ring, distracting the referee as he picks it up and gets rid of it. In that moment, he hits Cassidy over the head with the shillelagh and he gets the winning pinfall.&nbsp;\r\nDavid Finlay def. Orange Cassidy via Pinfall\r\nThe Conglomeration run down to the ring as Finlay goads them on, joined by the Gunns at ringside. With their attention on them, Clark Connors sneaks a spear on Cassidy and runs back up the ramp. ","datePublished":"2026-11-12T02:01:31+00:00","author":{"@type":"Person","name":"Max Everett"}},{"@type":"BlogPosting","url":"https:\/\/www.wrestlinginc.com\/2314240\/aew-dynamite-november-11-2026-results\/#update-4633","articleBody":"Andrade is backstage to talk about his National Championship loss with Renee Paquette. He says as one door closes, another opens, gesturing towards his World Title Contract.&nbsp;\r\nHe promises he will be the first Latino AEW World Champion.&nbsp;\r\n[embed=https:\/\/x.com\/AEW\/status\/2120699568870371579]","datePublished":"2026-11-12T02:04:00+00:00","author":{"@type":"Person","name":"Max Everett"}},{"@type":"BlogPosting","url":"https:\/\/www.wrestlinginc.com\/2314240\/aew-dynamite-november-11-2026-results\/#update-4634","articleBody":"Britt Baker makes her entrance before introducing Persephone for a match with Gypsy Mac.&nbsp;\r\nMac wants to shake hands with Persephone. Persephone obliges before using it to dump Mac down to the mat. She follows up with a basement dropkick, mounting her and punching while yelling her grief over the TBS Championship.&nbsp;\r\nHer loss of focus allows Mac to rally, hitting a Capoeira kick. Persephone locks in, pulling her opponent up for a Razor's Edge for the winning pinfall.&nbsp;\r\nPersephone def. Gypsy Mac via Pinfall","datePublished":"2026-11-12T02:12:39+00:00","headline":"Persephone vs. Gypsy Mac","author":{"@type":"Person","name":"Max Everett"}},{"@type":"BlogPosting","url":"https:\/\/www.wrestlinginc.com\/2314240\/aew-dynamite-november-11-2026-results\/#update-4635","articleBody":"From MrMojoRisin73 in the comments, which seems to have kicked off a whole OC discussion: \"I like Orange [Cassidy], but I think he hit his peak when he was International Champion.\"\r\nIt does feel like Cassidy is in need of some kind of evolution or shake up. I'm not saying change him; you should never fix what isn't broken, but he could definitely use a remastering. He needs a good story to blow the dust off him and light a real fire under him again.","datePublished":"2026-11-12T02:14:40+00:00","author":{"@type":"Person","name":"Ross W Berman IV"}},{"@type":"BlogPosting","url":"https:\/\/www.wrestlinginc.com\/2314240\/aew-dynamite-november-11-2026-results\/#update-4636","articleBody":"Excalibur notes that this is also a Number One Contenders' match.&nbsp;\r\nCash Wheeler and Alex Shelley start things off, Wheeler driving Shelley into the corner and tagging in Dax Harwood. Shelley gives them both the slip and retreats to his side of the ring, allowing Chris Sabin to come in and equalize the numbers.&nbsp;\r\nShelley and Harwood continue the exchange inside the ring, Shelley getting the better and maintaining control over the arm of Harwood. Harwood still pushes Shelley into the corner, tagging out to Wheeler. Shelley fights them both off again and assumes control over the arm of Wheeler.&nbsp;\r\nHe tags Sabin into the bout. Wheeler drives him into the corner, Sabin slips and rolls to the other side of the ring. Shelley re-enters and this time they all begin to brawl, Harwood against Sabin and Wheeler against Shelley.&nbsp;\r\nWheeler drives Sabin into the barricade, but then gets whipped himself into it by Shelley. Shelley helps Sabin back into the ring to work over Harwood.&nbsp;\r\nSabin throws Harwood into the outstretched feet of Shelley before tagging him in. Shelley starts to crank Harwood's neck, but Harwood chops the chest to begin an exchange. Shelley breaks the exchange with a chinbreaker and runs the ropes. Wheeler kicks him in the back, prompting Shelley to turn his attention thus allowing Harwood to get a chop block to resume control.&nbsp;\r\nWheeler tags in and begins to work the knee before constricting the neck on the mat.&nbsp;","datePublished":"2026-11-12T02:23:42+00:00","headline":"FTR vs. Motor City Machine Guns - Best of Five Series Finale","author":{"@type":"Person","name":"Max Everett"}},{"@type":"BlogPosting","url":"https:\/\/www.wrestlinginc.com\/2314240\/aew-dynamite-november-11-2026-results\/#update-4637","articleBody":"Wheeler softens Shelley's resolve with left jabs but gets dropped. Wheeler is forced to tag out to Harwood, who tries to catch Shelley but finds the same fate as his partner.&nbsp;\r\nShelley crawls to the other side of the ring but Wheeler storms in and tries to hit Sabin off the apron. Sabin catches him and the referee comes in to separate. But it means he misses a tag from Shelley to Sabin.&nbsp;\r\nHarwood and Wheeler fail to truly take advantage and Shelley gets the long-awaited tag. Sabin comes in and begins to rally against both members of FTR, dropping Wheeler with a DDT for a two-count.&nbsp;\r\nWheeler dumps Sabin onto the ropes with a belly-to-back throw and then a suplex, putting Shelley onto the top rope and joining him for something. Sabin comes to help his partner, but Wheeler succeeds in knocking Shelley off the top rope before Sabin again manages to fight them both off.&nbsp;\r\nWheeler goes for the ring bell and manages to clock Sabin with it behind the referee's back. Harwood makes the cover but Sabin kicks out at two.&nbsp;\r\nHarwood takes Sabin into the corner to sink in a chop, hammer throwing him to the opposite corner to jar the back. Another chop appears to wake Sabin up as he comes back with right hands. Harwood drops Sabin for the attempt and makes a lateral press cover for two.&nbsp;\r\nFTR set up for the spike piledriver, but Sabin slips Harwood and slingshots him into Wheeler on the top rope. Shelley comes into the ring, doubling them up in the corner for machine gun chops to each of them.&nbsp;\r\nShelley holds Harwood and Wheeler in position as Sabin takes flight for a kick, Shelley dropping them with a DDT-legsweep combo. Harwood kicks out at two.&nbsp;\r\nShelley sends Wheeler to the outside of the ring but gets backslid by Harwood into a cover. Shelley kicks out at two.&nbsp;\r\nA chopping exchange ensues with Shelley and Harwood joined by the wrists. Five minutes remain, as announced by Justin Roberts.&nbsp;\r\nSabin drops Wheeler with a cutter as he enters the ring. MCMG double up for kicks to different levels of Harwood. Sabin takes out Wheeler with a tope. Shelley hits a flying knee strike to Stokely Hathaway.&nbsp;\r\nShelley spikes Harwood and goes for the cover. But Wheeler dives through the ropes to make the save.&nbsp;\r\nWheeler and Sabin crash over the ropes with a suplex from the former. Hathaway trips Shelley and holds his boots as Harwood makes the cover. Shelley survives and chases him around ringside, into the ring, and gets caught with a Shatter Machine. Sabin makes the save.&nbsp;\r\nHathaway enters the ring again to argue with the referee. Sabin drops Hathaway, but gets a Spike Piledriver for it. FTR connect with another Spike Piledriver to Shelley and Harwood makes the cover, Shelley kicks out before the count of three.&nbsp;","datePublished":"2026-11-12T02:37:06+00:00","author":{"@type":"Person","name":"Max Everett"}},{"@type":"BlogPosting","url":"https:\/\/www.wrestlinginc.com\/2314240\/aew-dynamite-november-11-2026-results\/#update-4638","articleBody":"One minute is remaining.&nbsp;\r\nHarwood looks to get Shelley up for another Spike Piledriver. Shelley collapses to the mat each time.&nbsp;\r\nThirty seconds left.&nbsp;\r\nFTR look for Shatter Machine instead, Shelley sunset flips Harwood and tries for a cover. He upkicks Wheeler to send him through the ropes, getting the cover. One. Two. Three.&nbsp;\r\nMotor City Machine Guns def. FTR via Pinfall to win the Best of Five Series 3-2\r\n[embed=https:\/\/x.com\/AEW\/status\/2120708063892033933]","datePublished":"2026-11-12T02:38:52+00:00","author":{"@type":"Person","name":"Max Everett"}},{"@type":"BlogPosting","url":"https:\/\/www.wrestlinginc.com\/2314240\/aew-dynamite-november-11-2026-results\/#update-4639","articleBody":"FTR shake hands with MCMG when all is said and done. Though Hathaway looks none the happier for it.&nbsp;","datePublished":"2026-11-12T02:40:17+00:00","author":{"@type":"Person","name":"Max Everett"}},{"@type":"BlogPosting","url":"https:\/\/www.wrestlinginc.com\/2314240\/aew-dynamite-november-11-2026-results\/#update-4640","articleBody":"The bell rings and champion and challenger get things started with a chopping exchange. Bailey takes Ciampa off his feet and continues to hammer him in the corner with kicks to the chest. Ciampa boots Bailey in the face in response, sending him to the outside. Bailey rushes back to the ring but Ciampa repels him.&nbsp;\r\nCiampa brings him back in the ring. Bailey comes back and Ciampa slips to the outside of the ring, but Bailey follows with a skytwister press to the floor. Bailey brings Ciampa to the ring but Ciampa continues to retreat to the other side. Bailey follows and hits a kick to send him off his feet again.&nbsp;\r\nBailey brings him back to the ring. But Ciampa hits Bailey with Widow's Bell, sending his challenger back to the floor clutching his neck. Ciampa follows and hits a running knee strike to Bailey against the steel steps. Bailey is busted open.&nbsp;","datePublished":"2026-11-12T02:47:29+00:00","headline":"Tommaso Ciampa (C) vs. Mike Bailey - AEW National Championship","author":{"@type":"Person","name":"Max Everett"}},{"@type":"BlogPosting","url":"https:\/\/www.wrestlinginc.com\/2314240\/aew-dynamite-november-11-2026-results\/#update-4641","articleBody":"Ciampa seeks to open up the cut with angled punches, digging his fingers into the wound and stomping against his head on the floor.\r\nCiampa rubs the blood on himself, putting Bailey back in the ring. Ciampa comes in with another kick to the face, now driving the elbow into the cut.\r\nCiampa drapes Bailey over the middle rope and begins to bite at cut. The crowd doesn't hesitate to inform him he's a sick f***.&nbsp;\r\nBailey starts to fight back, sponging return strikes from Ciampa to deliver a roundhouse to send him to the mat. Bailey goes for a running shooting star press, Ciampa rolls out of the way and hits a German suplex. He maintains the waist control, bringing Bailey up and back down with another and then continuing to elbow down at the cut.&nbsp;\r\nBailey comes back once more, climbing to the top rope. Ciampa runs to meet him from the apron, hoisting him up for an Air Raid Crash. Bailey slips it and tries for a sunset flip. Ciampa punches out of the powerbomb position and manages to land an Air Raid Crash onto the apron.&nbsp;\r\nHe rolls Bailey back into the ring and connects with Project Ciampa. He goes for the cover. Bailey kicks out at two.&nbsp;","datePublished":"2026-11-12T02:52:43+00:00","author":{"@type":"Person","name":"Max Everett"}},{"@type":"BlogPosting","url":"https:\/\/www.wrestlinginc.com\/2314240\/aew-dynamite-november-11-2026-results\/#update-4642","articleBody":"Ciampa exposes the knee and lines up Bailey for the strike. Bailey collapses back down before Ciampa can hit it.&nbsp;\r\nCiampa calls for the referee to check on Bailey and call the match. Bailey says he's ready to go, slapping Ciampa and rocking him with a side heelkick.&nbsp;\r\nOff the next exchange the action goes to the ring apron, with Bailey hitting his moonsault knee drop onto Ciampa on the apron. He goes to the top rope, but Ciampa comes up to meet him, trying for a superplex.&nbsp;\r\nBailey headbutts him and Ciampa ends up hung on the ropes. Bailey continues to kick down until Ciampa starts to bite his toes. Bailey falls down to the apron but still kicks Ciampa off, connecting with the Ultimate Weapon. He goes for the cover. One. Two. Ciampa kicks out, just.&nbsp;\r\nBailey's looking for the spinning kick in the corner, connecting with it and looking for the Flamingo Driver. Ciampa fights him off, biting the cut, but Bailey kicks him to the head.&nbsp;\r\nBailey tries for a hurricanrana but Ciampa catches him, turning it into an avalanche Project Ciampa. He goes for the cover. Bailey kicks out.&nbsp;\r\nCiampa drops the knee pad and connects with the knee strike. He goes for the cover. Bailey kicks out again.&nbsp;\r\nCiampa connects with another knee strike. He goes for the cover. Bailey does not kick out this time.&nbsp;\r\nTommaso Ciampa def. Mike Bailey via Pinfall to retain the AEW National Championship","datePublished":"2026-11-12T03:00:35+00:00","author":{"@type":"Person","name":"Max Everett"}},{"@type":"BlogPosting","url":"https:\/\/www.wrestlinginc.com\/2314240\/aew-dynamite-november-11-2026-results\/#update-4643","articleBody":"The lights have dropped. The metronome is on the ramp. Ilja Dragunov is here.&nbsp;\r\nDragunov enters the ring, Ciampa gets in his face and holds the title aloft. Dragunov steps back and points towards the Titantron.&nbsp;\r\nA graphic shows that Ilja Dragunov will challenge Tommaso Ciampa for the AEW National Championship at Full Gear.&nbsp;\r\nCiampa extends his hand. Dragunov goes to shake it. Ciampa flips him off and retreats from the ring. Dragunov's music plays as he orchestrates a symphony of pain specifically for his next opponent.&nbsp;\r\n[embed=https:\/\/x.com\/AEW\/status\/2120714638916562986]","datePublished":"2026-11-12T03:05:07+00:00","author":{"@type":"Person","name":"Max Everett"}},{"@type":"BlogPosting","url":"https:\/\/www.wrestlinginc.com\/2314240\/aew-dynamite-november-11-2026-results\/#update-4644","articleBody":"And that's it for the \"AEW Dynamite\" portion of the show. I will be leaving you in the capable hands of Samantha for \"AEW Collision.\" Thanks for watching along!","datePublished":"2026-11-12T03:09:34+00:00","author":{"@type":"Person","name":"Max Everett"}},{"@type":"BlogPosting","url":"https:\/\/www.wrestlinginc.com\/2314240\/aew-dynamite-november-11-2026-results\/#update-4645","articleBody":"Hey Colliders! Thanks to Max for holding down the fort for \"Dynamite\". I'll be taking over for \"Collision\" and what a match to kick it off!","datePublished":"2026-11-12T03:12:26+00:00","headline":"Jay White & Mercedes Mon\u00e9 vs. Jon Moxley & Marina Shafir","author":{"@type":"Person","name":"Samantha Schipman"}},{"@type":"BlogPosting","url":"https:\/\/www.wrestlinginc.com\/2314240\/aew-dynamite-november-11-2026-results\/#update-4646","articleBody":"The ref is banning everyone from ringside.&nbsp;\r\nWhite and Mox start us off. White put Mox in a side headlock and took him to a knee. He sent him stumbling with a shoulder tackle. Marina kicked at Jay's face.&nbsp;\r\nWhite back in the ring after picking up the Continental title. White put him in another side headlock, ran the ropes and went to the outside before tagging in Mercedes. Mercedes tells Mox \"I want her!\"\r\nMarina got in and Mercedes tagged out. Jay shh'd the booing crowd. Marina kicked him in the butt. Mox sent him out and Marina did the same. Marina bounced her head off the announce desk while Mox chopped White against the barricade.&nbsp;\r\nMox put White back in the ring. Marina and Mercedes are in the ring too. They have their opponents in the corner and pummel and bite them. Marina slapped White and chopped him. He caught her leg, so he stood up on him to hit him. Mercedes landed a backstabber. White sent Mox off the apron before connecting with a backbreaker on Marina.&nbsp;","datePublished":"2026-11-12T03:17:24+00:00","author":{"@type":"Person","name":"Samantha Schipman"}},{"@type":"BlogPosting","url":"https:\/\/www.wrestlinginc.com\/2314240\/aew-dynamite-november-11-2026-results\/#update-4647","articleBody":"Editor On Duty note: I guess this is still technically the overrun for AEW Dynamite? Or is it Collision with Dynamite graphics? No one knows for sure. I remain befuddled by the parameters of AEW double-bill broadcasting.&nbsp;\r\nEither way, it's after 10 pm ET, and Samantha is gonna keep the train rolling until there's no more wrestling.","datePublished":"2026-11-12T03:20:07+00:00","author":{"@type":"Person","name":"Ross W Berman IV"}},{"@type":"BlogPosting","url":"https:\/\/www.wrestlinginc.com\/2314240\/aew-dynamite-november-11-2026-results\/#update-4648","articleBody":"We're back from break and Mercedes is dominating Marina. She took her down with a dropkick and tagged in White, who scoop slammed Marina. White had her by the face and she slapped him. White lifted her up, but she escaped and tagged in Mox. They exchange blows.\r\nMox landed a knee to the head. He reversed a bladerunner into a roll up. Mox sent him to the outside and followed with a tope suicida. Mercedes landed one on him.\r\nBack in the ring, Mox landed a delayed piledriver on White. He transitioned to the bulldog and Mercedes stomped him the head. She slapped him and Mox grabbed her, but White took his leg out. Mercedes landed a frog splash. Mox landed the Paradigm Shift.\r\nMercedes and Marina tag in. Marina supelxed her and did a armdrag. White pulled Marina's hair to make her let go. Mercedes put Mox in the Statement Maker and Marina put White in a triangle hold.&nbsp;\r\nMox and Marina tee off on White.&nbsp;","datePublished":"2026-11-12T03:25:06+00:00","author":{"@type":"Person","name":"Samantha Schipman"}},{"@type":"BlogPosting","url":"https:\/\/www.wrestlinginc.com\/2314240\/aew-dynamite-november-11-2026-results\/#update-4649","articleBody":"Mercedes landed a lungblower on Marina. Mercedes lowblowed Mox. Mox landed a cutter on Mercedes. White with a suplex on Mox. Mox landed a King Kong lariat on White. This match rules!&nbsp;\r\nMercedes hit the Mon\u00e9 Maker on Marina, but Marina rolled her into The Brutalizer to make the Women's World Champion tap 3 days before their Full Gear match.\r\nWinner: Marina & Mox\r\nAfter the match, Mercedes put Marina in the Statement Maker. The Cut comes down to attack Death Riders. KOR and Roddy Strong come out. Cassidy with taped ribs comes out over the barricade. He landed Orange Punch on The Dogs and Ace Austin, who saved White. KOR landed a knee on Colten. Roddy with a backbreaker on Austin Gunn. KOR put Colten in the ankle lock, but The Dogs drag him away. Mercedes is clutching her title by the announce desk. Jay is yelling at them. Orange and Mox shake hands.&nbsp;\r\nMercedes hit Marina in the back with her title. ","datePublished":"2026-11-12T03:31:17+00:00","author":{"@type":"Person","name":"Samantha Schipman"}},{"@type":"BlogPosting","url":"https:\/\/www.wrestlinginc.com\/2314240\/aew-dynamite-november-11-2026-results\/#update-4650","articleBody":"Walker Stewart is on commentary.&nbsp;\r\nThe Bucks & Perry come to the ring first. DCF follows.&nbsp;\r\nCage sent Matt to the mat and then to the apron. He punched Clon and Cage. The Bucks double team Cage and Clon. Matt landed an armdrag on&nbsp;Knight. The Bucks double team him.&nbsp;\r\nPerry tagged in and they triple kick Clon. Perry chopped Clon the corner. Perry used the ropes for an armdrag and dropkick. This is Clon's first AEW match in three months.\r\nPerry shoved Knight off the apron, Clon with a P\u00e9le Kick. Knight with a sliding lariat. The Bucks got knocked down and DCF double teams Perry. Perry sent Cage to the barricade. Perry slid under the ring and waved at Knight. Knight followed and ate a double kick from the Bucks. They keep outsmarting the DCF.&nbsp;\r\nPerry landed a leaping 'rana on Knight. The babyfaces landed triple topes on the heels. ","datePublished":"2026-11-12T03:41:12+00:00","headline":"Young Bucks & Jack Perry vs. Kevin Knight, Brian Cage, and El Clon","author":{"@type":"Person","name":"Samantha Schipman"}},{"@type":"BlogPosting","url":"https:\/\/www.wrestlinginc.com\/2314240\/aew-dynamite-november-11-2026-results\/#update-4651","articleBody":"There has been so much happening in this match, so a typical Bucks match. I'm doing my best to keep up!\r\nBack from break, DCF tee off on Perry. Knight landed a dropkick on Perry and covered him for two. Perry turned him inside out.&nbsp;\r\nNick tagged and did a crossbody on Knight and Clon. He kicked Cage in the face and takes out Knight and Clon. Matt tagged in and they double team Clon. Clon walked the rope, but Matt kicked him and Matt did a headscissor. They did a joint suplex on Knight. Matt took out Clon and KNight. Cage put Matt in a delayed vertical suplex. Nick kicked him in the gut. The Bucks tried to lift up Cage. Perry hit him in the back. They put on the barricade and Perry did a leaping kick to the back of the head.&nbsp;\r\nThe Bucks double team Clon and Knight in the ring. The Bucks landed on Knight and Clon while Perry did a moonsault on Cage. It was not a 3-corner massacre, but close.\r\nThe Bucks hit each other's knee. Knight did a combo on them and hurricanrana on Nick. Perry with a diving DDT. Cage did side slam on Perry. Clon landed a DDT on Perry. Knight with the UFO Splash, but the Bucks break it up.&nbsp;","datePublished":"2026-11-12T03:49:25+00:00","author":{"@type":"Person","name":"Samantha Schipman"}},{"@type":"BlogPosting","url":"https:\/\/www.wrestlinginc.com\/2314240\/aew-dynamite-november-11-2026-results\/#update-4652","articleBody":"Cage had Matt over his shoulder and Clon put Perry on the other. Nick superkicked Clon and Cage. The babyfaces take down Cage with kicks. Perry kicked Clon and the Bucks superkicked Knight.&nbsp;\r\nMatt and Perry take Knight and Clon over to Nick and he kicked them and landed a senton on Cage. Stereo BTE triggers on Clon for the win.\r\nWinner: Young Bucks and Jack Perry","datePublished":"2026-11-12T03:51:59+00:00","author":{"@type":"Person","name":"Samantha Schipman"}},{"@type":"BlogPosting","url":"https:\/\/www.wrestlinginc.com\/2314240\/aew-dynamite-november-11-2026-results\/#update-4653","articleBody":"Backstage, Lexy interviewed Divine Dominion. They put each other over from their Blood & Guts match. Kross said through blood, they become immortal. They will not seek revenge. Bayne said the destruction they will do is what they were going to do anyway.&nbsp;","datePublished":"2026-11-12T03:53:29+00:00","author":{"@type":"Person","name":"Samantha Schipman"}},{"@type":"BlogPosting","url":"https:\/\/www.wrestlinginc.com\/2314240\/aew-dynamite-november-11-2026-results\/#update-4654","articleBody":"Backstage, Lexy is with the Bucks and Perry. Perry called out Samoa Joe. He said he still owes him a rematch.&nbsp;\r\nThe Bucks won't make any excuses. That might have been the worst loss in their career. Matt says they're the Founders, the elite of the Elite, the Young Bucks. At the end of night at Full Gear, they'll still be champions.&nbsp;","datePublished":"2026-11-12T03:57:57+00:00","author":{"@type":"Person","name":"Samantha Schipman"}},{"@type":"BlogPosting","url":"https:\/\/www.wrestlinginc.com\/2314240\/aew-dynamite-november-11-2026-results\/#update-4655","articleBody":"Is this a standby match?\r\nWardlow is accompanied by Davis & Doyle. Nick Comoroto is already in the ring. Aaron Solo and Griff Garrison are with him.\r\nComoroto put him in a side headlock. He shoulder tackled Wardlow, who moved a little. Wardlow headbutted Comoroto, who fell to his knee. He followed with a lariat. He landed a powerbomb and put a foot on his chest to pin him.&nbsp;\r\nWinner: Wardlow\r\nAfter the match, Wardlow, Davis, and Doyle powerbomb Soloroto and Garrison.","datePublished":"2026-11-12T04:01:39+00:00","headline":"Wardlow vs. Nick Comoroto","author":{"@type":"Person","name":"Samantha Schipman"}}]}</script>
                </head>
<body>
